[Unit]
Description=ASUSTOR LCM front-panel status display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# @LCM_STATUS_BIN@ is substituted by deploy.sh with the built binary's
# actual path in this checkout -- not /usr/local/sbin, which is under
# TrueNAS's read-only /usr on a fresh boot environment (see deploy.sh).
ExecStart=@LCM_STATUS_BIN@ daemon /etc/lcm-status.toml
Restart=on-failure
RestartSec=2
# Fan fail-safe. When systemd kills the daemon (watchdog SIGABRT, SIGKILL
# after a stuck stop, the OOM killer, a crash) its restore-on-exit never
# runs and the fan would stay at its last manual PWM -- possibly low -- until
# the restarted daemon retakes it; handing back to BIOS automatic mode is no
# answer, it stops this board's fan. ExecStopPost runs after *every* stop,
# clean or not, and forces each enabled fan to manual, full speed (bounded
# to 3s inside the binary; it takes no serial lock and touches no LCD or
# socket). No leading '-': a non-zero exit means a present fan could not be
# set (no chip at all exits 0), and that should show as a failed unit
# rather than be ignored; Restart=on-failure restarts either way.
# `lcm-status fan-profile` stops this unit and then drives pwm itself, so
# full speed right after the stop is harmless there.
ExecStopPost=@LCM_STATUS_BIN@ fan-failsafe /etc/lcm-status.toml
# Graceful stop is ~5s fan-thread join + 3s fail-safe + other cleanup; the
# default 90s would leave a daemon that ignores SIGTERM (e.g. a wedged main
# loop) running that long before SIGKILL. 20s covers the graceful path with
# slack and keeps ExecStopPost (also bounded by this) plus restart prompt.
TimeoutStopSec=20
# Liveness: a dedicated daemon thread pings the service watchdog
# (sd_notify, over $NOTIFY_SOCKET) only while the fan thread's heartbeat is
# fresh (<15s) and the main loop has made progress within 300s, so a wedged
# fan thread or a truly stuck main loop gets the process restarted instead
# of leaving a fan unsupervised, while a slow subprocess-heavy refresh does
# not. WatchdogSec=60 leaves the 15s fan bound ample slack.
# NotifyAccess=main: only the daemon's own process may send those pings.
WatchdogSec=60
# Keep the default WatchdogSignal=SIGABRT rather than SIGTERM. A watchdog
# trip means the process is wedged, which is exactly when a SIGTERM that
# only sets a flag would go unheard: the daemon would keep running (fans
# unsupervised) until TimeoutStopSec, then be SIGKILLed anyway. SIGABRT ends
# it at once and leaves a core for diagnosis; ExecStopPost above provides
# the fan restore the graceful path would have, so nothing is lost.
NotifyAccess=main
# Needs root: /dev/ttyS1, the LCD power GPIO/LED, smartctl, and
# systemctl poweroff/reboot for the panel's shutdown/restart action and
# the power schedule, and /sys/class/rtc/rtc0/wakealarm for its power on.

# Sandboxing. Deliberately conservative: only directives that cannot get
# in the way of what the daemon does (write sysfs/hwmon/LED/rtc, open
# /dev/ttyS1 and /dev/input/event*, run modprobe, systemctl, zpool,
# smartctl, docker, ip and udevadm). ProtectSystem, ProtectKernel*,
# PrivateDevices and Capability* are NOT set for that reason.
#
# The daemon never gains privileges it doesn't already have, nor creates
# setuid files; a compromised child can't escalate through a setuid binary.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Private /tmp, and no access to home directories.
PrivateTmp=yes
ProtectHome=yes
# The daemon talks to the Unix socket, the middleware/dbus, and netlink
# (link state); nothing else (no AF_PACKET, AF_BLUETOOTH, ...).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Fixed lookup path for the subprocesses it spawns by bare name.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
